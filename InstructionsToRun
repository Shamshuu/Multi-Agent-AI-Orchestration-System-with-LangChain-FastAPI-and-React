5. FUNCTIONALITY 3: REAL-TIME WEBSOCKET STREAMING TRACE
================================================================================

Verify bidirectional WebSocket streaming from the command line:
$ docker compose exec api python3 -c "
import asyncio, json, websockets, httpx

async def stream_test():
    # 1. Post a task
    async with httpx.AsyncClient() as client:
        resp = await client.post('http://localhost:8000/api/tasks', json={
            'prompt': 'Plan and search weather in Paris, France and calculate 25 * 4'
        })
        task_id = resp.json()['task_id']
        print(f'Created Task: {task_id}')

    # 2. Connect to WebSocket stream
    uri = f'ws://localhost:8000/api/ws/{task_id}'
    print(f'Listening on WebSocket: {uri}\n')
    async with websockets.connect(uri) as ws:
        while True:
            try:
                msg = await asyncio.wait_for(ws.recv(), timeout=12.0)
                event = json.loads(msg)
                agent = event.get('agent', 'System')
                etype = event.get('event_type')
                print(f'  [EVENT] Agent={agent:<12} Type={etype}')
                if etype == 'COMPLETE':
                    print('\n>>> Workflow Completed Successfully! <<<')
                    break
            except asyncio.TimeoutError:
                break

asyncio.run(stream_test())
"

Expected Output:
Created Task: <uuid>
Listening on WebSocket: ws://localhost:8000/api/ws/<uuid>

  [EVENT] Agent=Planner      Type=AGENT_THOUGHT
  [EVENT] Agent=Planner      Type=STATE_TRANSITION
