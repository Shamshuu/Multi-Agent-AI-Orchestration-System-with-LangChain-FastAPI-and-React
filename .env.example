# ==============================================================================
# Multi-Agent AI Orchestration System - Environment Configuration
# ==============================================================================

# LLM Providers (Groq recommended for high-speed inference; OpenAI also supported)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/multiagent_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/multiagent_db

# Message Broker & Result Backend (Redis 7+)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional Tool APIs (Open-Meteo works without keys; DuckDuckGo works out of the box)
OPENWEATHER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Multi-Agent AI Orchestration System"
